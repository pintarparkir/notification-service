# notification-service — sample environment file.
# Copy to configs/.env (gitignored) and adjust per environment.
#
# notification-service has no public REST/gRPC surface — it's an event
# consumer + SMS dispatcher. So no APP_PORT / GRPC_PORT here.

APP_NAME=notification-service
APP_ENV=local

# ── RabbitMQ (event consumer + DLQ) ──────────────────────────────────────────
# Use `localhost` when running on the host (make run / go run).
# Use `rabbitmq` (the service name) when running inside docker compose.
RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=parkirpintar.events
RABBIT_QUEUE=notification.events
RABBIT_DLQ=notification.events.dlq

# ── user-service gRPC (MSISDN lookup) ────────────────────────────────────────
USER_GRPC_ADDR=localhost:9094
USER_GRPC_TIMEOUT=2s

# ── Observability ────────────────────────────────────────────────────────────
OTLP_ENDPOINT=localhost:4317

# ── SMS gateway ──────────────────────────────────────────────────────────────
# SMS_MODE: stub (logs only, default) or telkomsel (real HTTP gateway, TBD)
SMS_MODE=stub
SMS_SENDER_ID=ParkirPintar
